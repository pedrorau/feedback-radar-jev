# ── TypeSafe / Jev (requerido) ────────────────────────────────
# Copia este archivo a .env y pega tu propia API key de TypeSafe.
# Consíguela (gratis) en https://console.typesafe.ai  →  API Keys
# El .env NUNCA se sube al repo (está en .gitignore).
TS_API_KEY=ts_tu_key_aqui

# ── LLM para la comparativa de velocidad (opcional) ───────────
# Solo si quieres usar el botón "Comparar velocidad con un LLM".
# Provider: openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=sk-tu_key_del_llm_aqui
# Modelo a usar. Ajusta al que tengas acceso.
#   openai:    gpt-4o-mini, gpt-4o, ...
#   anthropic: claude-3-5-sonnet-latest, ...
LLM_MODEL=gpt-4o-mini

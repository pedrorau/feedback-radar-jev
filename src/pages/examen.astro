---
// Página /examen — experimento: ¿hasta dónde llega Jev resolviendo
// preguntas de opción múltiple? Reutiliza el proxy /api/jev.
// Las preguntas son estilo examen de admisión UNMSM, redactadas para
// esta demo (no copiadas de ningún solucionario), con respuestas
// verificadas. Mezcla conceptuales (Jev suele acertar) y de cálculo
// multi-paso (donde se ve el "techo" del snap judgment).
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Examen San Marcos · Jev</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

<style is:global>
  :root {
    --paper: #f5f4f6; --card: #ffffff; --ink: #17151a; --muted: #6b6770;
    --line: #e4e2e7; --magenta: #e451ba; --magenta-deep: #a92c86;
    --ok: #17915f; --ok-bg: #e7f4ee; --bad: #c0392b; --bad-bg: #fbeae8;
    --track: #ecebef; --shadow: 0 1px 2px rgba(23,21,26,.05), 0 8px 24px rgba(23,21,26,.05);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink);
    font-family: "Space Grotesk", system-ui, sans-serif; line-height: 1.5; font-size: 15px; }
  .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
  .wrap { max-width: 880px; margin: 0 auto; padding: 28px 20px 64px; }

  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); text-decoration: none; margin-bottom: 18px; }
  .back:hover { color: var(--magenta-deep); }

  header .brand { display: flex; align-items: center; gap: 12px; }
  .dot { width: 30px; height: 30px; border-radius: 50%; flex: none;
    background: radial-gradient(circle at 35% 30%, #f57fce, var(--magenta) 60%, var(--magenta-deep)); }
  h1 { font-size: 24px; font-weight: 700; letter-spacing: -.02em; margin: 0; }
  .sub { color: var(--muted); font-size: 13.5px; margin: 2px 0 0; max-width: 60ch; }

  .run { margin: 22px 0 6px; padding: 13px 22px; border: none; border-radius: 11px;
    background: var(--ink); color: #fff; font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer; }
  .run:hover { background: #000; }
  .run:disabled { opacity: .5; cursor: default; }
  .err { margin-top: 14px; padding: 11px 13px; border-radius: 10px; font-size: 13px;
    background: #fcece9; color: #9a2b1a; border: 1px solid #f3cfc7; display: none; white-space: pre-wrap; }

  /* Scoreboard */
  .score { display: none; margin: 20px 0 8px; padding: 18px 20px; background: var(--card);
    border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); }
  .score .big { font-size: 30px; font-weight: 700; letter-spacing: -.02em; }
  .score .big b { color: var(--magenta-deep); }
  .score .rows { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 10px; font-size: 13px; color: var(--muted); }
  .score .rows b { color: var(--ink); font-weight: 700; }

  /* Questions */
  .q { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; margin-top: 12px; box-shadow: var(--shadow); }
  .q .head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
  .q .num { font-size: 12px; font-weight: 700; color: var(--muted); }
  .cat { font-size: 10.5px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid var(--line); color: var(--muted); }
  .cat.calc { color: var(--magenta-deep); border-color: #f0c3e4; background: #fdf3fa; }
  .stem { font-size: 15px; font-weight: 500; margin-bottom: 12px; }
  .opts { display: flex; flex-direction: column; gap: 6px; }
  .opt { display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 8px;
    padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px; font-size: 14px; }
  .opt .k { font-weight: 700; color: var(--muted); font-family: "JetBrains Mono", monospace; font-size: 13px; }
  .opt.pick { border-color: var(--ink); }
  .opt.correct { background: var(--ok-bg); border-color: var(--ok); }
  .opt.wrongpick { background: var(--bad-bg); border-color: var(--bad); }
  .opt .tag { font-size: 11px; font-weight: 700; }
  .opt.correct .tag { color: var(--ok); }
  .opt.wrongpick .tag { color: var(--bad); }
  .verdict { margin-top: 11px; font-size: 12.5px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .verdict .badge { font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 20px; }
  .verdict .badge.ok { background: var(--ok-bg); color: var(--ok); }
  .verdict .badge.bad { background: var(--bad-bg); color: var(--bad); }
  .verdict .conf { color: var(--muted); }
  .verdict .conf b { color: var(--ink); }

  footer { margin-top: 30px; text-align: center; color: var(--muted); font-size: 12px; max-width: 60ch; margin-left: auto; margin-right: auto; }
</style>
</head>
<body>
<div class="wrap">
  <a class="back" href="/">← Volver al radar</a>

  <header>
    <div class="brand">
      <div class="dot" aria-hidden="true"></div>
      <div>
        <h1>¿Jev resuelve un examen?</h1>
      </div>

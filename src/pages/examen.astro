const $ = (id) => document.getElementById(id);
const els = { run: $("run"), err: $("err"), score: $("score"), list: $("list") };
els.run.addEventListener("click", solve);

function esc(s) { return String(s).replace(/[&<>]/g, m => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[m])); }
function pct(x) { return Math.round(x * 100); }

async function solve() {
  els.run.disabled = true;
  els.run.textContent = "Resolviendo...";
  els.err.style.display = "none";
  els.score.style.display = "none";
  els.list.innerHTML = "";

  // Una sola request con las 12 preguntas como Choice en paralelo.
  const questions = {};
  EXAM.forEach((q, i) => {
    const criteria = {};
    q.options.forEach((opt, idx) => { criteria[LETTERS[idx]] = opt; });
    questions["q" + (i + 1)] = { type: "choice", instructions: q.stem, criteria };
  });

  const body = {
    state: { tarea: "Responde cada pregunta de opción múltiple del examen de admisión eligiendo la alternativa correcta." },
    model: "jev-latest",
    questions
  };

  const t0 = performance.now();
  try {
    const res = await fetch("/api/jev", {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body)
    });
    const ms = Math.round(performance.now() - t0);
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || ("HTTP " + res.status));
    renderResults(data.answers, ms, data.usage);
  } catch (e) {
    els.err.style.display = "block";
    els.err.textContent = e.message || String(e);
  } finally {
    els.run.disabled = false;
    els.run.textContent = "Resolver examen con Jev";
  }
}

function renderResults(answers, ms, usage) {
  let correct = 0;
  let cCon = 0, tCon = 0, cCal = 0, tCal = 0;

  els.list.innerHTML = "";
  EXAM.forEach((q, i) => {
    const ans = answers["q" + (i + 1)];
    const pick = ans ? ans.choice : null;
    const conf = ans && typeof ans.confidence === "number" ? ans.confidence : null;
    const isCorrect = pick === q.correct;

    if (q.tipo === "conceptual") { tCon++; if (isCorrect) cCon++; }
    else { tCal++; if (isCorrect) cCal++; }
    if (isCorrect) correct++;

    els.list.appendChild(renderQ(q, i, pick, conf, isCorrect));
  });

  const total = EXAM.length;
  const acc = Math.round(correct / total * 100);
  const cost = usage ? (usage.input_tokens / 1e6) * 0.042 : 0;

  els.score.style.display = "block";
  els.score.innerHTML =
    `<div class="big">Jev acertó <b>${correct} / ${total}</b> · ${acc}%</div>
     <div class="rows">
       <span>Conceptuales: <b>${cCon}/${tCon}</b></span>
       <span>Cálculo multi-paso: <b>${cCal}/${tCal}</b></span>
       <span><b>${ms} ms</b> las 12 en 1 request</span>
       ${usage ? `<span>~$${cost.toFixed(6)}</span>` : ``}
     </div>`;
  els.score.scrollIntoView({ behavior: "smooth", block: "start" });
}

function renderQ(q, i, pick, conf, isCorrect) {
  const card = document.createElement("div");
  card.className = "q";

  const opts = q.options.map((opt, idx) => {
    const k = LETTERS[idx];
    let cls = "opt", tag = "";
    if (k === q.correct) { cls += " correct"; tag = `<span class="tag">✓ correcta</span>`; }
    if (k === pick && !isCorrect) { cls += " wrongpick"; tag = `<span class="tag">✗ eligió Jev</span>`; }
    else if (k === pick && isCorrect) { tag = `<span class="tag" style="color:var(--ok)">✓ eligió Jev</span>`; }
    return `<div class="${cls}"><span class="k">${k}</span><span>${esc(opt)}</span>${tag}</div>`;
  }).join("");

  const badge = isCorrect
    ? `<span class="badge ok">Acertó</span>`
    : `<span class="badge bad">Falló</span>`;
  const confTxt = conf !== null ? `confianza <b>${conf.toFixed(2)}</b>` : "";

  card.innerHTML =
    `<div class="head">
       <span class="num">Pregunta ${i + 1}</span>
       <span class="cat ${q.tipo === "calc" ? "calc" : ""}">${esc(q.cat)}</span>
     </div>
     <div class="stem">${esc(q.stem)}</div>
     <div class="opts">${opts}</div>
     <div class="verdict">${badge}<span class="conf">${confTxt}</span></div>`;
  return card;
}
</script>
